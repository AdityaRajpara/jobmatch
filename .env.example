# Copy to .env and fill in, or export these directly.

# Leave unset and use JOBMATCH_BACKEND=fake to run without an API key.
ANTHROPIC_API_KEY=

JOBMATCH_BACKEND=anthropic      # anthropic | fake
JOBMATCH_MODEL=claude-sonnet-5-5
JOBMATCH_DB=jobmatch.db
JOBMATCH_WORKERS=4
JOBMATCH_MAX_ATTEMPTS=3
JOBMATCH_LEASE_SECONDS=300
JOBMATCH_JOB_TIMEOUT=120
JOBMATCH_REQUEST_TIMEOUT=45
